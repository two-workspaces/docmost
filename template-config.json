{
  "services": {
    "9951f3fd-b317-44fe-9206-d95530cea0f6": {
      "icon": "https://cdn.jsdelivr.net/gh/selfhst/icons/svg/docmost.svg",
      "name": "Docmost",
      "build": {},
      "deploy": {
        "startCommand": null,
        "healthcheckPath": "/api/health",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "ghcr.io/two-workspaces/docmost:eea3a5a"
      },
      "variables": {
        "PORT": {
          "defaultValue": "3000",
          "description": "Port Docmost listens on - leave as is",
          "isOptional": false
        },
        "DOCMOST_ADMIN_EMAIL": {
          "defaultValue": "",
          "description": "Your email - the workspace owner's login, created on first boot",
          "isOptional": false
        },
        "DOCMOST_ADMIN_PASSWORD": {
          "defaultValue": "${{secret(20, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Owner password, set on first boot only - copy it from here to log in, then change it in Docmost",
          "isOptional": false
        },
        "DOCMOST_WORKSPACE": {
          "defaultValue": "My Workspace",
          "description": "Workspace name, set on first boot only",
          "isOptional": false
        },
        "APP_URL": {
          "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Public URL used in links and emails - set it to your custom domain when you add one",
          "isOptional": false
        },
        "APP_SECRET": {
          "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Signs sessions - auto-generated, keep it secret",
          "isOptional": false
        },
        "DATABASE_URL": {
          "defaultValue": "postgresql://${{Postgres.POSTGRES_USER}}:${{Postgres.POSTGRES_PASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/${{Postgres.POSTGRES_DB}}",
          "description": "Postgres - private network, leave as is",
          "isOptional": false
        },
        "REDIS_URL": {
          "defaultValue": "redis://default:${{Redis.REDIS_PASSWORD}}@${{Redis.RAILWAY_PRIVATE_DOMAIN}}:6379?family=6",
          "description": "Redis - private network, leave as is",
          "isOptional": false
        },
        "RAILWAY_RUN_UID": {
          "defaultValue": "0",
          "description": "Run as root so Docmost can write to the attachments volume",
          "isOptional": false
        }
      },
      "networking": {
        "serviceDomains": {
          "<hasDomain>": {}
        }
      },
      "volumeMounts": {
        "9951f3fd-b317-44fe-9206-d95530cea0f6": {
          "mountPath": "/app/data/storage"
        }
      }
    },
    "81ca7766-0637-4048-b3e2-4b63c98c5ed6": {
      "icon": "https://devicons.railway.app/i/postgresql.svg",
      "name": "Postgres",
      "build": {},
      "deploy": {
        "startCommand": null,
        "healthcheckPath": null,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "ghcr.io/railwayapp-templates/postgres-ssl:18"
      },
      "variables": {
        "POSTGRES_DB": {
          "defaultValue": "docmost",
          "description": "Database name",
          "isOptional": false
        },
        "POSTGRES_USER": {
          "defaultValue": "docmost",
          "description": "Database user",
          "isOptional": false
        },
        "POSTGRES_PASSWORD": {
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Auto-generated database password",
          "isOptional": false
        },
        "PGDATA": {
          "defaultValue": "/var/lib/postgresql/data/pgdata",
          "description": "Data subdirectory - keeps Postgres happy on Railway volumes",
          "isOptional": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "60",
          "description": "Time for Postgres to shut down cleanly on redeploy",
          "isOptional": false
        }
      },
      "networking": {
        "serviceDomains": {}
      },
      "volumeMounts": {
        "81ca7766-0637-4048-b3e2-4b63c98c5ed6": {
          "mountPath": "/var/lib/postgresql/data"
        }
      }
    },
    "c2fa4a23-88f1-43f5-a0c7-12c944c93f9b": {
      "icon": "https://devicons.railway.app/i/redis.svg",
      "name": "Redis",
      "build": {},
      "deploy": {
        "startCommand": "/bin/sh -c \"exec docker-entrypoint.sh redis-server --requirepass $REDIS_PASSWORD --save '' --appendonly no\"",
        "healthcheckPath": null,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "source": {
        "image": "redis:8.10.2-alpine"
      },
      "variables": {
        "REDIS_PASSWORD": {
          "defaultValue": "${{secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Auto-generated Redis password",
          "isOptional": false
        }
      },
      "networking": {
        "serviceDomains": {}
      }
    }
  }
}
